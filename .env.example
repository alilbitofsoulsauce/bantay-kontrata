# Bantay-Kontrata Tagum — Environment Configuration Template
# Copy to `.env` for local overrides or configure in your cloud dashboard (Render / Railway / Docker).
# Never commit real tokens or `.env` files to version control.

# Bind host and port for `python app.py` / WSGI servers
HOST=127.0.0.1
PORT=8000

# SQLite database path for optimistic-concurrency case reviews and audit history
BANTAY_DB_PATH=instance/bantay-kontrata.sqlite3

# Bundled dashboard HTML snapshot path
BANTAY_DASHBOARD_PATH=review/Bantay_Kontrata_Dashboard.html

# Historical Tagum procurement & DPWH CSV directory used by LiveXAIEngine
BANTAY_DATA_DIR=data

# Allowed HTTP Host headers:
# - Default local mode: localhost,127.0.0.1
# - Agency domain mode: audit.tagum.gov.ph,localhost,127.0.0.1
# - Cloud PaaS wildcard mode (Render / Railway / Docker): *
BANTAY_TRUSTED_HOSTS=localhost,127.0.0.1

# Set to 1 or true when running behind a trusted TLS reverse proxy (Render, Railway, Nginx, Cloudflare)
# Enables Werkzeug ProxyFix (X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Host) for HTTPS same-origin checks
BANTAY_TRUSTED_PROXY=0

# Optional shared team write token for PUT /api/reviews (leave empty for local single-user mode)
# Example dummy placeholder (replace in production secrets manager):
# BANTAY_REVIEW_TOKEN=replace-with-random-team-review-token
BANTAY_REVIEW_TOKEN=
